    {
      "name": "press-release",
      "urls": [
        "https://www.skoda-storyboard.com/en/press-releases/skoda-superb-25-years-of-comfort-space-and-technical-excellence/"
      ],
      "description": "Škoda press release detail (press_release CPT, Media Room side). No hero: header (span.entry-published date + h1.entry-title) -> primary column default content (article-teaser lead image, .bullet-points inline list, .entry-summary lead, .entry-content body) -> secondary Gallery (section.images.sa-media-kit-preview) -> Tags (ol.entry-tags) -> full-bleed dark related band (div.cover-box.dark div.search-results.media-box) parsed as Downloads. AI-audio (Buzzsprout) embed + newsletter/banner widgets are removed by skoda-press-release-cleanup (Embeds → SKODA-204). Spec: docs/ui-specs/template-press-release.md; content model T15; tickets SKODA-601/607. Detection is content-driven only.",
      "blocks": [
        {
          "name": "gallery",
          "instances": [
            "section.images.sa-media-kit-preview"
          ]
        },
        {
          "name": "tags",
          "instances": [
            "section.tags"
          ]
        },
        {
          "name": "downloads",
          "instances": [
            ".cover-box.dark .search-results.media-box, .search-results.media-box"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Article",
          "selector": [
            "article.press_release > .container, article.press_release"
          ],
          "style": null,
          "blocks": [
            "gallery",
            "tags"
          ],
          "defaultContent": [
            "header .entry-published",
            "header .entry-title",
            ".column-primary .article-teaser",
            ".column-primary .bullet-points",
            ".column-primary .entry-summary",
            ".column-primary .entry-content"
          ]
        },
        {
          "id": "section-2",
          "name": "Related Media",
          "selector": [
            ".cover-box.dark"
          ],
          "style": "dark, full-width",
          "blocks": [
            "downloads"
          ],
          "defaultContent": []
        }
      ]
    },
    {
      "name": "pr-listing",
      "urls": [
        "https://www.skoda-storyboard.com/en/news/"
      ],
      "description": "Škoda faceted-listing page (template-search-results engine, e.g. /en/news/). INDEX-DRIVEN: emits a single `Listing` config block (index/path/template/facets/sort/perpage/columns) over the published query-index; the SSR result cards + Search-&-Filter-Pro/ElasticPress/Isotope stack are NOT ported. Page metadata is template=page (nav-only, not rail-indexed); listed items carry press_release metadata. Spec: docs/ui-specs/faceted-listing.md; content model T9; tickets SKODA-601/402. Detection is content-driven only.",
      "blocks": [
        {
          "name": "listing",
          "instances": [
            "#search-filter-results"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Listing",
          "selector": [
            "#search-filter-results"
          ],
          "style": null,
          "blocks": [
            "listing"
          ],
          "defaultContent": [
            "h1.entry-title, h1.page-title, main h1"
          ]
        }
      ]
    },
    {
      "name": "page-base",
